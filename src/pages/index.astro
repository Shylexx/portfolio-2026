---
// Grabs every markdown file in the projects folder
const projects = Object.values(import.meta.glob('./projects/*.md', { eager: true }));
---

<html lang="en">
  <body>
    <h1>My Portfolio</h1>
    <ul>
      {projects.map((project: any) => (
        <li>
          <a href={project.url}>{project.frontmatter.title}</a>
        </li>
      ))}
    </ul>
  </body>
</html>